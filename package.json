{
  "name": "foodhub-takeaway-saas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "dev:app": "tsx watch src/server.ts",
    "dev:payment": "tsx watch src/paymentServer.ts",
    "build": "tsc",
    "start": "node dist/dev.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "test:report": "tsx scripts/generateTestReport.ts",
    "ai:coverage": "tsx scripts/generateAiCoverageWorkbook.ts",
    "ai:analyze-failures": "tsx scripts/analyzeFailures.ts"
  },
  "dependencies": {
    "chai": "^4.5.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0",
    "xlsx": "^0.18.5"
  }
}
